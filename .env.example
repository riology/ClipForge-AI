# =============================================================================
# ClipForge AI — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your local setup.
# Never commit your .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=ClipForge AI
APP_VERSION=0.1.0
DEBUG=true

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Storage ---
# Relative to the project root. Change to an absolute path if needed.
STORAGE_DIR=./storage

# --- Database (Phase 2+) ---
# DATABASE_URL=postgresql://clipforge:clipforge@localhost:5432/clipforge

# --- Redis (Phase 2+) ---
# REDIS_URL=redis://localhost:6379/0

# --- Whisper Transcription (Phase 3) ---
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# --- Clip Generation (Phase 4) ---
MIN_CLIP_DURATION=15
PREFERRED_CLIP_DURATION_MIN=30
PREFERRED_CLIP_DURATION_MAX=60
MAX_CLIP_DURATION=90
MAX_CLIPS_RETURNED=10
